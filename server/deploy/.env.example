# Copy to .env on the server (never commit .env).
API_DOMAIN=api.example.com
DB_USER=funedu
DB_PASSWORD=change-me-to-a-long-random-password
# Signs FunEdu access tokens. At least 32 bytes: openssl rand -base64 48
AUTH_JWT_SECRET=
# Comma-separated Google OAuth client ids (Android, iOS, web).
GOOGLE_CLIENT_IDS=
# iOS bundle id, plus the Apple Services ID used on Android.
APPLE_CLIENT_IDS=com.ibme.funedu

# Backups (backup.sh / restore.sh): long random passphrase, keep a copy off the VM.
BACKUP_PASSPHRASE=
# Optional rclone remote off the VM, e.g. b2:funedu-backups
BACKUP_REMOTE=
